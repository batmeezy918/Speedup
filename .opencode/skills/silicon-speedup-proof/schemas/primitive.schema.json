{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speedup.local/schemas/silicon-speedup-proof/primitive.schema.json",
  "title": "Silicon Speedup Proof — Primitive Ledger Record",
  "description": "One append-only line of the canonical primitive ledger. Structural shape only; cross-record semantics (ordering, hash chain, status transitions, claim/evidence ordering, composition freshness) are enforced by scripts/validate-ledger.py and cannot be expressed in JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "seq",
    "primitive_id",
    "version",
    "timestamp",
    "kind",
    "status",
    "source_commit",
    "provenance",
    "claim",
    "evidence",
    "prev_hash",
    "record_hash"
  ],
  "properties": {
    "schema_version": { "const": "SSPROOF-1.0" },
    "record_type": { "const": "primitive" },

    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "Strictly increasing append order across the ledger file. Gaps are permitted (compaction); regression is not."
    },
    "primitive_id": {
      "type": "string",
      "pattern": "^P-[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Stable identity of the operational primitive across all of its ledger events."
    },
    "version": { "type": "integer", "minimum": 1 },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "kind": {
      "enum": ["primitive", "composition", "status_event", "formal"],
      "description": "A composition is a primitive whose components are other primitives; it still needs its own run."
    },
    "status": {
      "enum": [
        "proposed",
        "implemented",
        "measured",
        "reproduced",
        "verified",
        "regressed",
        "blocked",
        "superseded",
        "quarantined"
      ]
    },

    "source_commit": { "type": "string", "minLength": 7 },

    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "author", "synthetic"],
      "properties": {
        "origin": { "enum": ["native", "synthetic", "imported"] },
        "author": { "type": "string", "minLength": 1 },
        "synthetic": {
          "type": "boolean",
          "description": "true for validator fixtures. Synthetic records MUST be excluded from substantive coverage counts and MUST NOT be cited as hardware evidence."
        },
        "parent_ids": { "type": "array", "items": { "type": "string" } },
        "component_ids": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Primitives composed into this one. Only meaningful when kind == composition."
        },
        "source_ref": { "type": "string" },
        "scenario_hash": { "type": "string" }
      }
    },

    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "applicability_conditions", "exclusions"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "applicability_conditions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Conditions under which a prior VERIFIED result carries over. Absent or empty means: carries over to nothing."
        },
        "exclusions": { "type": "array", "items": { "type": "string" } }
      }
    },

    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "steps": { "type": "array", "items": { "type": "string" } },
        "refs": { "type": "array", "items": { "type": "string" } },
        "unresolved": { "type": "array", "items": { "type": "string" } }
      }
    },

    "operator": {
      "type": "object",
      "additionalProperties": false,
      "description": "psi_{k+1} = O_k psi_k. definition_status == implemented REQUIRES a resolvable source_ref under --repo-root; otherwise it is a DERIVATION gap.",
      "required": ["symbol", "definition_status"],
      "properties": {
        "symbol": { "enum": ["S", "Delta", "Omega", "Xi", "O_k", "identity"] },
        "definition_status": { "enum": ["undefined", "specified", "implemented"] },
        "spec": { "type": "string" },
        "source_ref": { "type": "string", "description": "Repository-relative path, e.g. engines/invariant.py" },
        "symbol_ref": { "type": "string", "description": "Symbol or line anchor inside source_ref" },
        "invariants": {
          "type": "array",
          "items": { "type": "string" },
          "description": "e.g. Omega(O psi), heat_trace(O), curvature(psi). Each entry must be defined or executable in the target project; otherwise it is a DERIVATION gap."
        }
      }
    },

    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "language": { "type": "string" },
        "baseline_path": { "type": "string" },
        "baseline_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },

    "native_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executed_kind"],
      "description": "executed_kind != native forbids every measured, reproduced and verified status. An empty run_id is permitted only for statuses that require no execution; validate-ledger.py enforces that via L-EXE-2.",
      "properties": {
        "run_id": { "type": "string" },
        "executed_kind": {
          "enum": ["native", "simulated", "dry_run", "static_inspection", "not_run"]
        },
        "command": { "type": "string" },
        "cwd": { "type": "string" },
        "exit_code": { "type": ["integer", "null"] },
        "stdout_ref": { "type": "string" },
        "stderr_ref": { "type": "string" },
        "artifact_ref": { "type": "string" },
        "environment": {
          "type": "object",
          "properties": {
            "platform": { "type": "string" },
            "machine": { "type": "string" },
            "cpu": { "type": "string" },
            "governor": { "type": "string" },
            "toolchain": { "type": "string" },
            "compiler_flags": { "type": "string" },
            "versions": { "type": "object", "additionalProperties": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "status": { "enum": ["resolved", "unresolved", "assumed"] },
              "ref": { "type": "string" }
            }
          }
        }
      }
    },

    "measurements": {
      "type": "array",
      "description": "Raw, per-arm timing samples. A measured ratio is not derivable from this field when it is empty.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["arm", "metric", "unit", "samples"],
        "properties": {
          "arm": { "enum": ["baseline", "candidate", "composition", "composition_baseline"] },
          "metric": { "type": "string", "minLength": 1 },
          "unit": { "enum": ["ns", "us", "ms", "s", "bytes", "ops", "count"] },
          "samples": { "type": "array", "items": { "type": "number" } },
          "warmup_discarded": { "type": "integer", "minimum": 0 },
          "aggregation": { "enum": ["median", "mean", "min", "p95", "p99"] },
          "interleaved": { "type": "boolean" },
          "scope": {
            "type": "string",
            "description": "Which timing domain this arm covers, e.g. 'stage-1 only' or 'end-to-end'. Mixing scopes in one ratio is a MEASUREMENT gap."
          },
          "input_size": { "type": "number" },
          "memory_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },

    "speedups": {
      "type": "object",
      "additionalProperties": false,
      "description": "Three distinct quantities. S_composed and S_cumulative require direct measurement unless measured_direct is false, in which case they MUST be absent.",
      "properties": {
        "S_i": { "type": ["number", "null"] },
        "S_ideal": { "type": ["number", "null"] },
        "S_ideal_model": { "enum": ["sequential_sum", "amortised", "critical_path", "undefined"] },
        "S_ideal_assumptions": { "type": "array", "items": { "type": "string" } },
        "S_composed": { "type": ["number", "null"] },
        "S_composed_measured_direct": { "type": "boolean" },
        "S_cumulative": { "type": ["number", "null"] },
        "S_cumulative_measured_direct": { "type": "boolean" },
        "interaction_factor": { "type": ["number", "null"] },
        "computation": {
          "enum": ["measured_direct", "model", "product_of_components", "unknown"],
          "description": "product_of_components is never admissible for S_composed or S_cumulative."
        }
      }
    },

    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "equivalence": { "$ref": "#/$defs/checkResult" },
        "reverse_reconstruction": { "$ref": "#/$defs/checkResult" },
        "invariant": { "$ref": "#/$defs/checkResult" }
      }
    },

    "formal": {
      "type": "object",
      "additionalProperties": false,
      "description": "A formal claim is only admissible with an exact theorem target AND a recorded command AND exit_status 0.",
      "required": ["theorem_target"],
      "properties": {
        "theorem_target": { "type": "string", "minLength": 1 },
        "file": { "type": "string" },
        "command": { "type": "string" },
        "exit_status": { "type": ["integer", "null"] },
        "output_ref": { "type": ["string", "null"] },
        "kernel_checked": { "type": "boolean" },
        "toolchain": { "type": "string" },
        "mathlib": { "type": "string" }
      }
    },

    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "description": "A mechanism claim without mechanism_specific evidence is bounded to 'unexplained observed effect'.",
      "properties": {
        "claim": { "type": "string" },
        "mechanism_specific": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "kind"],
            "properties": {
              "ref": { "type": "string", "minLength": 1 },
              "kind": {
                "enum": [
                  "counterfactual",
                  "ablation",
                  "hardware_counter",
                  "microarchitectural_trace",
                  "model_fit",
                  "prior_work",
                  "none"
                ]
              },
              "description": { "type": "string" }
            }
          }
        }
      }
    },

    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strength", "kind", "statement", "scope"],
      "properties": {
        "strength": { "enum": ["NONE", "CANDIDATE", "STRONG_LOCAL", "FORMAL_PARTIAL", "VERIFIED"] },
        "kind": {
          "enum": [
            "none",
            "performance",
            "implementation",
            "hardware_mechanism",
            "formal",
            "composition",
            "cumulative"
          ]
        },
        "statement": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "assigned_manually": { "type": "boolean" }
      }
    },

    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_strength", "refs", "transition_records"],
      "properties": {
        "evidence_strength": {
          "enum": [
            "UNEVIDENCED",
            "OBSERVED",
            "EXECUTED",
            "REPRODUCED",
            "CORRECTNESS",
            "MECHANISM",
            "FORMAL",
            "SCOPED_VERIFIED"
          ]
        },
        "refs": { "type": "array", "items": { "type": "string" } },
        "transition_records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "event_ref"],
            "properties": {
              "from": { "enum": ["UNEVIDENCED", "OBSERVED", "EXECUTED", "REPRODUCED", "CORRECTNESS", "MECHANISM", "FORMAL", "SCOPED_VERIFIED"] },
              "to": { "enum": ["UNEVIDENCED", "OBSERVED", "EXECUTED", "REPRODUCED", "CORRECTNESS", "MECHANISM", "FORMAL", "SCOPED_VERIFIED"] },
              "event_ref": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },

    "checks": {
      "type": "array",
      "description": "Optional declarative validation batch attached to this ledger event. Vacuous entries are excluded from substantive coverage counts.",
      "items": { "$ref": "#/$defs/check" }
    },

    "status_history": {
      "type": "array",
      "description": "Append-only status log. A previously observed regressed/blocked/verified state must remain present.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "timestamp", "seq"],
        "properties": {
          "status": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "minLength": 1 },
          "seq": { "type": "integer", "minimum": 1 },
          "event_ref": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },

    "known_regressions": { "type": "array", "items": { "type": "string" } },
    "open_gaps": { "type": "array", "items": { "type": "string" } },
    "downstream_dependencies": { "type": "array", "items": { "type": "string" } },
    "contradictions": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" },

    "prev_hash": {
      "type": "string",
      "pattern": "^([0-9a-f]{64}|GENESIS)$",
      "description": "record_hash of the previous line, or GENESIS for the first line."
    },
    "record_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 over canonical JSON of this record with record_hash removed."
    }
  },

  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "name", "parameters", "assertion", "observed", "passed"],
      "description": "Every field that lets a reader decide whether the check could have failed is mandatory.",
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "parameters": { "type": "object", "additionalProperties": true },
        "parameter_roles": { "type": "object", "additionalProperties": { "type": "string" } },
        "assertion": { "type": "string", "minLength": 1 },
        "expected_source": {
          "enum": ["spec", "independent_oracle", "fixture", "prior_art", "self"]
        },
        "expected": { "type": ["number", "string", "boolean", "null"] },
        "observed": { "type": ["number", "string", "boolean", "null"] },
        "passed": { "type": "boolean" },
        "artifact_ref": { "type": "string" },
        "synthetic": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass"],
      "properties": {
        "pass": { "type": ["boolean", "null"] },
        "metric": { "type": "string" },
        "tolerance": { "type": "number", "minimum": 0 },
        "observed": { "type": ["number", "string", "null"] },
        "expected": { "type": ["number", "string", "null"] },
        "artifact_ref": { "type": "string" },
        "vacuous": { "type": "boolean" },
        "note": { "type": "string" }
      }
    }
  }
}