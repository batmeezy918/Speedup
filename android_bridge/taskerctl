#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ACTION_DEFAULT="com.speedup.tasker.EXEC"
TASKER_PKG="net.dinglisch.android.taskerm"

usage() {
  echo "Usage:"
  echo "  taskerctl exec <task> [key=value ...]"
  echo "  taskerctl broadcast <action> [key=value ...]"
  echo "  taskerctl status"
}

status() {
  echo "Termux: $(cmd package path com.termux 2>/dev/null | head -1 || true)"
  echo "Termux:Tasker: $(cmd package path com.termux.tasker 2>/dev/null | head -1 || true)"
  echo "Tasker: $(cmd package path "$TASKER_PKG" 2>/dev/null | head -1 || true)"
}

broadcast() {
  local action="$1"; shift
  local args=(am broadcast --user 0 -a "$action" -p "$TASKER_PKG")
  for kv in "$@"; do
    key="${kv%%=*}"
    val="${kv#*=}"
    args+=(--es "$key" "$val")
  done
  echo "CALL: ${args[*]}"
  "${args[@]}"
}

exec_task() {
  local task="$1"; shift
  local args=(am broadcast --user 0 -a net.dinglisch.android.taskerm.ACTION_TASK -p "$TASKER_PKG" --es task_name "$task")
  if (( $# > 0 )); then
    local names="" values="" sep=""
    for kv in "$@"; do
      key="${kv%%=*}"; val="${kv#*=}"
      names+="${sep}${key}"; values+="${sep}${val}"; sep=","
    done
    args+=(--es varNames "$names" --es varValues "$values")
  fi
  echo "CALL: ${args[*]}"
  "${args[@]}"
}

case "${1:-}" in
  exec) shift; exec_task "$@" ;;
  broadcast) shift; broadcast "$@" ;;
  status) status ;;
  *) usage; exit 2 ;;
esac
