{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"PCSS Evidence Certificate",
  "type":"object",
  "required":["run_id","scenario_hash","source_hash","gates"],
  "properties":{
    "run_id":{"type":"string"},
    "scenario_hash":{"type":"string"},
    "source_hash":{"type":"string"},
    "input_hash":{"type":"string"},
    "environment_hash":{"type":"string"},
    "trace_hash":{"type":"string"},
    "quotient_hash":{"type":"string"},
    "reverse_hash":{"type":"string"},
    "proof_hash":{"type":"string"},
    "gates":{
      "type":"object",
      "required":["integrity","reproducibility","quotient_forward","reconstruction_reverse","invariants","performance","lean"],
      "properties":{
        "integrity":{"type":"boolean"},
        "reproducibility":{"type":"boolean"},
        "quotient_forward":{"type":"boolean"},
        "reconstruction_reverse":{"type":"boolean"},
        "invariants":{"type":"boolean"},
        "performance":{"type":"boolean"},
        "lean":{"type":"boolean"}
      },
      "additionalProperties":false
    },
    "performance":{
      "type":"object",
      "properties":{
        "metric":{"type":"string"},
        "baseline":{"type":"number"},
        "candidate":{"type":"number"},
        "median_baseline":{"type":"number"},
        "median_candidate":{"type":"number"},
        "p95_baseline":{"type":"number"},
        "p95_candidate":{"type":"number"},
        "p99_baseline":{"type":"number"},
        "p99_candidate":{"type":"number"},
        "samples":{"type":"integer","minimum":1}
      },
      "additionalProperties":true
    }
  },
  "additionalProperties":true
}
